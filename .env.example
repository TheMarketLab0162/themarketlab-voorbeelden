# Auth.js: genereer met `npx auth secret` of `openssl rand -base64 32`
AUTH_SECRET=
# GitHub OAuth-app (callback: https://voorbeeld.themarketlab.nl/admin/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Komma-gescheiden numerieke GitHub-gebruikers-ID's met admin-toegang
ADMIN_GITHUB_IDS=

# Global Config (Edge Config): leesverbinding voor de proxy, wordt automatisch gezet bij koppelen
GLOBAL_CONFIG=
# ID van dezelfde store (ecfg_...), voor schrijfacties via de REST API
GLOBAL_CONFIG_ID=

# Vercel REST API: token met toegang tot het team The MarketLab
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=team_GVB47PlfcTeKGN6KrIzbISdz
